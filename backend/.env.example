# Supabase Database Configuration
# Obtain credentials from Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key

# Server Runtime (Render automatically provides PORT in production)
HOST=0.0.0.0
PORT=8000

# CORS Configuration for Deployed Vercel Frontend
# Set FRONTEND_URL to your deployed Vercel domain on Render
FRONTEND_URL=https://your-app-name.vercel.app
# Alternatively, specify comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

